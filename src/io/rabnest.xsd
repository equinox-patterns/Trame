<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           version="1.0">

  <!-- ===== Root ===== -->

  <xs:element name="rabnest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="info" type="InfoType"/>
        <xs:element name="sizes" type="SizesType"/>
        <xs:element name="nesting" type="NestingType" minOccurs="0"/>
        <xs:element name="cover" type="CoverType" minOccurs="0"/>
        <xs:element name="artboards" type="ArtboardsType" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- ===== Simple types ===== -->

  <xs:simpleType name="HexColor">
    <xs:restriction base="xs:string">
      <xs:pattern value="#[0-9a-fA-F]{6}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="HexColorOrNone">
    <xs:restriction base="xs:string">
      <xs:pattern value="#[0-9a-fA-F]{6}|none"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NonNegativeDouble">
    <xs:restriction base="xs:double">
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StrokeWidth">
    <xs:restriction base="xs:double">
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FillRule">
    <xs:restriction base="xs:string">
      <xs:enumeration value="nonzero"/>
      <xs:enumeration value="evenodd"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FontWeight">
    <xs:restriction base="xs:string">
      <xs:enumeration value="normal"/>
      <xs:enumeration value="bold"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TextAlign">
    <xs:restriction base="xs:string">
      <xs:enumeration value="left"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="right"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SizeLayerNaming">
    <xs:restriction base="xs:string">
      <xs:enumeration value="value-only"/>
      <xs:enumeration value="size-prefix"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LabelTypeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="text"/>
      <xs:enumeration value="logo"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CoverBlockTypeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="text"/>
      <xs:enumeration value="image"/>
      <xs:enumeration value="shape"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NestingAlgorithm">
    <xs:restriction base="xs:string">
      <xs:enumeration value="simulated-annealing"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NestingCost">
    <xs:restriction base="xs:string">
      <xs:enumeration value="minimize-height"/>
      <xs:enumeration value="minimize-length"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PathData">
    <xs:restriction base="xs:string">
      <xs:pattern value="[MCLZ0-9\.\-eE\s]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ===== Info ===== -->

  <xs:complexType name="InfoType">
    <xs:sequence>
      <xs:element name="patternName" type="xs:string"/>
      <xs:element name="brandName" type="xs:string" minOccurs="0"/>
      <xs:element name="sourceFile" type="xs:string" minOccurs="0"/>
      <xs:element name="mepLayerName" type="xs:string"/>
      <xs:element name="sizeLayerNaming" type="SizeLayerNaming"/>
      <xs:element name="created" type="xs:dateTime"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===== Path ===== -->

  <xs:complexType name="PathType">
    <xs:attribute name="d" type="PathData" use="required"/>
    <xs:attribute name="fill" type="HexColorOrNone" default="none"/>
    <xs:attribute name="stroke" type="HexColor" default="#000000"/>
    <xs:attribute name="strokeWidth" type="StrokeWidth" default="1.0"/>
    <xs:attribute name="strokeDasharray" type="xs:string" default=""/>
    <xs:attribute name="fillRule" type="FillRule" default="nonzero"/>
  </xs:complexType>

  <!-- ===== Sizes ===== -->

  <xs:complexType name="SizesType">
    <xs:sequence>
      <xs:element name="range" type="RangeType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RangeType">
    <xs:sequence>
      <xs:element name="mep" type="MepType"/>
      <xs:element name="size" type="SizeType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="minSize" type="xs:double" use="required"/>
    <xs:attribute name="maxSize" type="xs:double" use="required"/>
    <xs:attribute name="stature" type="xs:double" default="0"/>
  </xs:complexType>

  <!-- MEP -->

  <xs:complexType name="MepType">
    <xs:sequence>
      <xs:element name="piece" type="MepPieceType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MepPieceType">
    <xs:sequence>
      <xs:element name="grainlines" type="GrainlinesType" minOccurs="0"/>
      <xs:element name="labels" type="LabelsType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="group" type="xs:string" default=""/>
  </xs:complexType>

  <xs:complexType name="GrainlinesType">
    <xs:sequence>
      <xs:element name="path" type="PathType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="LabelsType">
    <xs:sequence>
      <xs:element name="label" type="LabelType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Label (text or logo) -->

  <xs:complexType name="LabelType" mixed="true">
    <xs:sequence minOccurs="0">
      <xs:element name="path" type="PathType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="type" type="LabelTypeEnum" use="required"/>
    <xs:attribute name="blockId" type="xs:int" default="0"/>
    <xs:attribute name="x" type="xs:double" default="0"/>
    <xs:attribute name="y" type="xs:double" default="0"/>
    <xs:attribute name="rotation" type="xs:double" default="0"/>
    <!-- Text-only attributes -->
    <xs:attribute name="fontFamily" type="xs:string"/>
    <xs:attribute name="fontSize" type="xs:double" default="12"/>
    <xs:attribute name="fontWeight" type="FontWeight" default="normal"/>
    <xs:attribute name="fill" type="HexColor" default="#000000"/>
    <xs:attribute name="align" type="TextAlign" default="left"/>
  </xs:complexType>

  <!-- Size -->

  <xs:complexType name="SizeType">
    <xs:sequence>
      <xs:element name="piece" type="SizePieceType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="value" type="xs:double" use="required"/>
    <xs:attribute name="label" type="xs:string" use="required"/>
    <xs:attribute name="layerName" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="SizePieceType">
    <xs:sequence>
      <xs:element name="contour" type="ContourType" minOccurs="0"/>
      <xs:element name="internal" type="InternalType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="group" type="xs:string" default=""/>
  </xs:complexType>

  <xs:complexType name="ContourType">
    <xs:sequence>
      <xs:element name="path" type="PathType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="InternalType">
    <xs:sequence>
      <xs:element name="path" type="PathType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===== Nesting ===== -->

  <xs:complexType name="NestingType">
    <xs:sequence>
      <xs:element name="placement" type="PlacementType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="binWidth" type="xs:double" use="required"/>
    <xs:attribute name="gap" type="NonNegativeDouble" default="2"/>
    <xs:attribute name="rotationStep" type="NonNegativeDouble" default="2"/>
    <xs:attribute name="algorithm" type="NestingAlgorithm" default="simulated-annealing"/>
    <xs:attribute name="cost" type="NestingCost" default="minimize-height"/>
  </xs:complexType>

  <xs:complexType name="PlacementType">
    <xs:attribute name="piece" type="xs:string" use="required"/>
    <xs:attribute name="group" type="xs:string" default=""/>
    <xs:attribute name="x" type="xs:double" use="required"/>
    <xs:attribute name="y" type="xs:double" use="required"/>
    <xs:attribute name="rotation" type="xs:double" use="required"/>
  </xs:complexType>

  <!-- ===== Cover ===== -->

  <xs:complexType name="CoverType">
    <xs:sequence>
      <xs:element name="block" type="CoverBlockType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CoverBlockType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="type" type="CoverBlockTypeEnum" use="required"/>
        <xs:attribute name="x" type="xs:double" use="required"/>
        <xs:attribute name="y" type="xs:double" use="required"/>
        <xs:attribute name="width" type="NonNegativeDouble" use="required"/>
        <xs:attribute name="height" type="NonNegativeDouble" use="required"/>
        <!-- Text attributes -->
        <xs:attribute name="fontFamily" type="xs:string"/>
        <xs:attribute name="fontSize" type="xs:double"/>
        <xs:attribute name="fontWeight" type="FontWeight"/>
        <xs:attribute name="fill" type="HexColor"/>
        <xs:attribute name="align" type="TextAlign"/>
        <!-- Image attributes -->
        <xs:attribute name="href" type="xs:string"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- ===== Artboards ===== -->

  <xs:complexType name="ArtboardsType">
    <xs:attribute name="width" type="NonNegativeDouble" default="210"/>
    <xs:attribute name="height" type="NonNegativeDouble" default="297"/>
    <xs:attribute name="columns" type="xs:positiveInteger" default="1"/>
    <xs:attribute name="rows" type="xs:positiveInteger"/>
    <xs:attribute name="showCutMarks" type="xs:boolean" default="true"/>
    <xs:attribute name="showAssemblyMarks" type="xs:boolean" default="true"/>
  </xs:complexType>

</xs:schema>
